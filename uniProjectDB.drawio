        <mxCell id="kWLGCwOxszkKAL75RuBp-8" parent="WIyWlLk6GJQsqaUBKTNV-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Whenever there is media file that doesn&#39;t exist in the other device, user get notified , and need to send them via LAN Network to the new device , but , how can we send them from device to device , securely ?" vertex="1">
